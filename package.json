{
  "name": "lit-distribution",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lit/database generate",
    "db:migrate": "pnpm --filter @lit/database migrate",
    "db:seed": "pnpm --filter @lit/database seed",
    "db:reset": "pnpm --filter @lit/database reset",
    "db:studio": "pnpm --filter @lit/database studio",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:psql": "docker compose -f infrastructure/docker/docker-compose.yml exec postgres psql -U lit -d lit_distribution"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
