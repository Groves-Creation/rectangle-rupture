# Copy to .env and adjust. Never commit .env.

# ---- Database ----
POSTGRES_USER=lit
POSTGRES_PASSWORD=lit_local_dev
POSTGRES_DB=lit_distribution
# Port 5433: a native PostgreSQL Windows service commonly occupies 5432.
DATABASE_URL=postgresql://lit:lit_local_dev@localhost:5433/lit_distribution

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=3000
# Must be 0.0.0.0 (not 127.0.0.1) so a physical Android device can reach the API.
API_HOST=0.0.0.0
NODE_ENV=development
# Use the LAN/Tailscale address here when testing product photos on a phone.
PUBLIC_API_URL=http://localhost:3000
# Local image storage. Mount this path to persistent storage in production.
IMAGE_UPLOAD_DIR=./data/product-images

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Admin dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- Mobile ----
# Passed to Flutter via --dart-define=API_BASE_URL=...
# Wi-Fi LAN:   http://192.168.1.144:3000
# Tailscale:   http://100.88.157.98:3000

# ---- Email (Resend) ----
# Create a server-side API key at https://resend.com/api-keys.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# Use onboarding@resend.dev for testing; use a verified-domain sender in production.
RESEND_FROM_EMAIL=onboarding@resend.dev
