# Normalise to LF in the repository. Windows checkouts still get CRLF where
# the platform expects it, but the committed bytes stay consistent across the
# Windows dev machine and the Linux CI runners.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to remain executable.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and reviews.
pnpm-lock.yaml linguist-generated=true -diff
packages/database/migrations/meta/*.json linguist-generated=true -diff
